ARG BUILDER
ARG VENDOR
FROM ${BUILDER} AS build
ENV GOTOOLCHAIN=local GOOS=linux GOARCH=amd64 GOAMD64=v1 CGO_ENABLED=0 \
    GOWORK=off GOFLAGS=-mod=readonly GOMAXPROCS=2 \
    GOTMPDIR=/build/go-work TMPDIR=/build/scratch
RUN apk add --no-cache git python3 && mkdir -p /build/go-work /build/scratch
WORKDIR /src
COPY upstream/ ./
COPY build.py settings.json security.patch /build/
RUN python3 /build/build.py

FROM ${VENDOR} AS runtime
ARG RUNTIME_PACKAGES
RUN apk add --no-cache ${RUNTIME_PACKAGES}
COPY --from=build /build/application /usr/bin/kubectl
COPY --from=build /build/provenance/ /usr/share/maintained-go/
LABEL org.opencontainers.image.source="https://github.com/blazepower/rishik-homelab-rke2" \
      io.homelab.derivative="Owned kubectl from exact public source with declared Go/dependency fixes and minimal runtime; not an official Kubernetes build"
